<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error Page</title>
    <link
      type="image/png"
      sizes="16x16"
      rel="shortcut icon"
      href="./favicon.png"
    />
    <link type="image/png" sizes="32x32" rel="icon" href="./favicon-32.png" />
    <link type="image/png" sizes="96x96" rel="icon" href="./favicon-96.png" />
    <link
      type="image/png"
      sizes="120x120"
      rel="icon"
      href="./favicon-120.png"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Arvo"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/404.css" />
  </head>
  <body>
    <main>
      <section class="page_404">
        <div class="container">
          <div class="row">
            <div class="col-sm-12">
              <div class="col-sm-10 col-sm-offset-1 text-center">
                <div class="four_zero_four_bg">
                  <h1 class="text-center"><%= statusCode %></h1>
                </div>

                <div class="contant_box_404">
                  <h3 class="h2">Look like you're lost</h3>
                  <h1>Error: <%= errorMessage %></h1>
                  <p>the page you are looking for not avaible!</p>

                  <a href="/" class="link_404">Go to Home</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- <% if (stackTrace) { %>
    <pre><%= stackTrace %></pre>
    <% } else { %>
    <p>No additional error details are available.</p>
    <% } %> -->
    </main>
  </body>
</html>
